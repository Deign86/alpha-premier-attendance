{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alpha Premier Attendance",
  "mainBinaryName": "alpha-premier-attendance",
  "version": "0.1.0",
  "identifier": "com.alphapremier.attendance",
  "build": {
    "frontendDist": "../client/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Alpha Premier Attendance",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/**"]
      },
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* http://192.168.*:*; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
