{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alpha Premier Attendance",
  "mainBinaryName": "alpha-premier-attendance",
  "version": "0.1.48",
  "identifier": "com.alphapremier.attendance",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../client/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Alpha Premier Attendance",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/**"]
      },
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* http://192.168.*:*; font-src 'self' asset: data:; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1RTVCM0Y5RDlBRjBFRTkKUldUcERxL1orYlBsaFdrQ0NmZ0hVaW4wMHFJYmlMelpvV0puRGI3NUI4RDJJZmNiUElsdGlnNFUK",
      "endpoints": [
        "https://github.com/Deign86/alpha-premier-attendance/releases/latest/download/latest.json"
      ]
    }
  }
}
