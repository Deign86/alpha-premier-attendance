HOST=0.0.0.0
PORT=3001
NODE_ENV=development
# Comma-separated trusted browser origins; same-origin LAN viewers do not need CORS.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

GOOGLE_SHEET_ID=your_google_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_KEY\n-----END PRIVATE KEY-----\n"

# Optional Google Drive folder auto-create/reuse. When GOOGLE_DRIVE_FOLDER_ID
# is set, the server verifies the folder and adds the spreadsheet to it without removing existing parents.
# When it is unset or missing, GOOGLE_CREATE_FOLDER_IF_MISSING creates a folder
# and persists its ID for reuse across restarts.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_NAME=Alpha Premier Attendance
GOOGLE_CREATE_FOLDER_IF_MISSING=false
# Local JSON state path for the persisted Drive folder/spreadsheet IDs.
# Defaults to ~/.rfid-attendance/google-sheets-state.json when unset.
GOOGLE_SHEETS_STATE_FILE=

TIMEZONE=Asia/Manila
SCAN_COOLDOWN_SECONDS=10
RFID_AUTO_SUBMIT_DELAY_MS=150
ENABLE_SCAN_SOUNDS=true
ENABLE_CARD_SETUP=false
SETUP_ADMIN_PIN=replace-with-a-local-admin-pin
SETUP_SESSION_MINUTES=15

# Optional local development controls
RESULT_RESET_DELAY_MS=4000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
